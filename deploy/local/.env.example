# Local development configuration.
# Copy this file to `.env` next to the compose file if you need to override it.

# Host ports. They avoid clashing with other local stacks on 5432/8080.
BACKEND_HOST_PORT=8090
DB_HOST_PORT=5434

# Port for the Expo dev server.
EXPO_PORT=8083

# Back-end JWT signing secret. Must be at least 32 bytes; the default is
# already long enough. Keep it stable so tokens survive back-end restarts.
JWT_SECRET=dev-secret-do-not-use-in-prod-0123456789
